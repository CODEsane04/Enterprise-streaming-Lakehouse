# ============================================================
# Enterprise Agentic Streaming Lakehouse - Environment Variables Template
# ============================================================

# Database Configuration (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=olist_ecommerce

# Storage Configuration (MinIO / S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_ENDPOINT=http://minio:9000
S3_EXTERNAL_ENDPOINT=http://localhost:9000
S3_BUCKET=lakehouse
AWS_REGION=us-east-1

# Streaming Platform (Redpanda / Kafka)
REDPANDA_HOST=redpanda
REDPANDA_BROKER_PORT=9092
REDPANDA_EXTERNAL_BROKER_PORT=19092
REDPANDA_SCHEMA_REGISTRY_PORT=8081
REDPANDA_ADMIN_PORT=9644
REDPANDA_CONSOLE_PORT=8088

# REST Catalog (Apache Polaris)
POLARIS_HOST=polaris
POLARIS_PORT=8181
POLARIS_URI=http://polaris:8181/api/catalog
POLARIS_EXTERNAL_URI=http://localhost:8181/api/catalog
POLARIS_CLIENT_ID=<your-polaris-client-id>
POLARIS_CLIENT_SECRET=<your-polaris-client-secret>

# Distributed Query Engine (Trino)
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_EXTERNAL_PORT=8089
TRINO_URI=http://trino:8080
