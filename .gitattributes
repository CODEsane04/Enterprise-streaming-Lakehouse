# Enforce Unix line endings (LF) across all operating systems
# Prevents Windows CRLF auto-conversion issues inside Linux Docker containers
* text=auto eol=lf

# Explicitly ensure SQL, Shell, Docker, and Config files use LF
*.sql text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env text eol=lf
*.env.example text eol=lf
*.py text eol=lf
*.md text eol=lf
